# Configuración de Entorno - Refaccionaria Central
# Duplica este archivo como .env y coloca tus valores locales

# Base de datos SQL Server
DB_HOST=10.10.214
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASS=

# Opciones de seguridad
# true para desarrollo local (muestra errores de BD), false para producción
APP_DEBUG=false

# Clave secreta para cookies de sesión o firmas (mínimo 32 caracteres)
APP_SECRET=cambiar_por_cadena_secreta_aleatoria_de_32_caracteres_min
